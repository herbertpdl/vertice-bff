PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# Comma-separated browser origins allowed to call the BFF directly. Only browser clients that
# hit the BFF themselves need an entry: Expo web (vertice-mobile `npm run web`, Metro on :8081).
# vertice-web-react does not: its Next server proxies to the BFF server-side.
CORS_ORIGIN=http://localhost:8081

VERTICE_API_GRPC_HOST=localhost
VERTICE_API_GRPC_PORT=9090

# Must equal vertice-api's JWT_SECRET: the BFF forwards its own JWT upstream and
# vertice-api verifies it with this shared secret. This is the BFF's dev default, the shared
# local-dev value that vertice-api and vertice-local adopt as theirs. It is public: unless
# NODE_ENV is development or test (or unset), the BFF refuses it and any secret under 32 bytes.
# Generate a real one with `openssl rand -base64 48`.
JWT_SECRET=vertice-dev-jwt-secret-do-not-use-in-production
JWT_EXPIRES_IN=8h

# Login checks passwords through vertice-api's VerifyCredentials. `false` restores the old
# email-only login (any password works) for the rollout window; refused unless NODE_ENV is
# development or test. It looks the user up with an unauthenticated ListUsers, so it only works
# against vertice-api running with its `local` profile.
VERIFY_PASSWORDS=true

# Peers allowed to pass the client IP in X-Forwarded-For (comma-separated addresses/CIDRs, or
# `loopback`). Deployed, set it to vertice-web-react's server address: the web calls the BFF
# server-side and forwards the browser's IP, otherwise every web user shares one rate-limit
# bucket. Add any reverse proxy in front of the BFF. false is fine for local dev.
TRUST_PROXY=false

# Loose per-IP bucket over every route.
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
# Strict per-IP/per-email buckets on login, register and password setup/change (15 minutes).
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_MS=900000
# Strict-bucket limit per IPv6 /48 or IPv4 /24 (unset: 20 × AUTH_RATE_LIMIT_MAX).
# AUTH_RATE_LIMIT_NETWORK_MAX=100
# Most strict-bucket keys held in memory (~230 MB at 1M); when full, new clients get 429 until
# buckets expire.
AUTH_RATE_LIMIT_MAX_KEYS=1000000

# Current versions of the legal texts (P1-04), served by GET /api/legal/versions: the Terms of
# Use / Privacy Policy, and the health-data consent notice. 1-32 of [A-Za-z0-9._-]. Bump one when
# its text changes; users whose stored consent has another version are asked again. The texts are
# drafts pending legal review.
TERMS_VERSION=2026-10-draft
HEALTH_DATA_CONSENT_VERSION=2026-10-draft
