PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

VERTICE_API_GRPC_HOST=localhost
VERTICE_API_GRPC_PORT=9090

# Must equal vertice-api's JWT_SECRET: the BFF forwards its own JWT upstream and
# vertice-api verifies it with this shared secret.
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=8h
