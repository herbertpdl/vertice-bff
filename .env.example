PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# Comma-separated browser origins allowed to call the BFF directly. Only browser clients that
# hit the BFF themselves need an entry: Expo web (vertice-mobile `npm run web`, Metro on :8081).
# vertice-web-react does not: its Next server proxies to the BFF server-side.
CORS_ORIGIN=http://localhost:8081

VERTICE_API_GRPC_HOST=localhost
VERTICE_API_GRPC_PORT=9090

# Must equal vertice-api's JWT_SECRET: the BFF forwards its own JWT upstream and
# vertice-api verifies it with this shared secret. This is the BFF's dev default, the shared
# local-dev value that vertice-api and vertice-local adopt as theirs. It is public: unless
# NODE_ENV is development or test (or unset), the BFF refuses it and any secret under 32 bytes.
# Generate a real one with `openssl rand -base64 48`.
JWT_SECRET=vertice-dev-jwt-secret-do-not-use-in-production
JWT_EXPIRES_IN=8h
