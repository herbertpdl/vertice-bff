# Production image: compiled JS on the Node runtime, production dependencies only, non-root.
# The dev `Dockerfile` runs `tsx watch` instead and is for vertice-local's compose.

FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN --mount=type=cache,target=/root/.npm npm ci
COPY tsconfig.json tsconfig.build.json ./
COPY src ./src
RUN npm run build

FROM node:22-alpine AS deps
WORKDIR /app
COPY package*.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --omit=dev --ignore-scripts

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=deps /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
# Loaded at runtime from ../../protos relative to dist/grpc (src/grpc/loadProto.ts).
COPY protos ./protos
COPY package.json ./
USER node
EXPOSE 3000
# Node directly rather than `npm start`, so SIGTERM reaches the process and close-with-grace drains.
CMD ["node", "dist/server.js"]
