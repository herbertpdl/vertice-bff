{
  "name": "vertice-bff",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend for Frontend for vertice-web, bridging HTTP/JSON to the vertice-api gRPC service",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:docker": "CHOKIDAR_USEPOLLING=true tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:hostile-tz": "TZ=Pacific/Kiritimati vitest run",
    "sync:protos": "tsx scripts/sync-protos.ts",
    "openapi": "tsx scripts/generate-openapi.ts",
    "ops:issue-setup-tokens": "tsx scripts/issue-setup-tokens.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@grpc/grpc-js": "^1.14.6",
    "@grpc/proto-loader": "^0.7.13",
    "close-with-grace": "^2.1.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.5",
    "fastify-plugin": "^5.0.1",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fastify/swagger": "9.9.2",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "eslint": "^9.14.0",
    "fastify-type-provider-zod": "7.0.0",
    "openapi-types": "12.1.3",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
